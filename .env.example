CANVASRELAY_ENV=development
CANVASRELAY_DEMO_MODE=true
CANVASRELAY_IMAGE_PROVIDER=demo
CANVASRELAY_COMFYUI_BASE_URL=http://127.0.0.1:8188
CANVASRELAY_COMFYUI_WORKFLOW_PATH=
CANVASRELAY_COMFYUI_EDIT_WORKFLOW_PATH=
CANVASRELAY_COMFYUI_EDIT_FACE_WORKFLOW_PATH=
CANVASRELAY_COMFYUI_EDIT_LORA_ALLOWLIST_PATH=.local/image-edit-loras.json
CANVASRELAY_COMFYUI_OUTPUT_NODE_ID=
CANVASRELAY_COMFYUI_STALLED_AFTER_SECONDS=90
CANVASRELAY_CODEX_OAUTH_ENABLED=false
CANVASRELAY_CODEX_OAUTH_PROXY_PORT=18765
CANVASRELAY_CODEX_OAUTH_TIMEOUT_SECONDS=120
CANVASRELAY_CODEX_OAUTH_PARALLEL_JOBS=2
CANVASRELAY_CODEX_OAUTH_DAILY_JOB_LIMIT=30
CANVASRELAY_CODEX_OAUTH_IP_DAILY_JOB_LIMIT=10
CANVASRELAY_CODEX_OAUTH_ALLOW_REMOTE_GENERATION=false
CANVASRELAY_CODEX_OAUTH_ALLOW_REMOTE_MANAGEMENT=false
# Docker's private bridge may be allowed only for a localhost-bound Compose stack.
CANVASRELAY_CODEX_OAUTH_ALLOW_DOCKER_GATEWAY=false
# Optional. Select a model exposed by the local OAuth proxy; do not put a token here.
CANVASRELAY_CODEX_OAUTH_MODEL=
CANVASRELAY_DATA_DIR=.canvasrelay
CANVASRELAY_DATABASE_URL=sqlite+pysqlite:///./.canvasrelay/canvasrelay.sqlite3
CANVASRELAY_DATABASE_POOL_SIZE=5
CANVASRELAY_DATABASE_MAX_OVERFLOW=10
CANVASRELAY_MAX_UPLOAD_BYTES=20971520
CANVASRELAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_CANVASRELAY_API_URL=http://localhost:8000
CANVASRELAY_API_PORT=18080
CANVASRELAY_WEB_PORT=13080
CANVASRELAY_POSTGRES_PORT=15432
CANVASRELAY_POSTGRES_DB=canvasrelay
CANVASRELAY_POSTGRES_USER=canvasrelay
CANVASRELAY_POSTGRES_PASSWORD=canvasrelay-dev-only
